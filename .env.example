# Copy this file to .env, replace every placeholder, and keep the resulting file private.
# Generate each of the first three values independently with: openssl rand -hex 32
CAUSALITY_SESSION_HMAC_KEY=replace_with_first_openssl_rand_hex_32_value
CAUSALITY_AUTH_IP_HASH_KEY=replace_with_second_openssl_rand_hex_32_value
CAUSALITY_INTERNAL_MCP_SECRET=replace_with_third_openssl_rand_hex_32_value

# This value has a different format. Generate it with: openssl rand -base64 32
CAUSALITY_TOKEN_ENCRYPTION_KEY=replace_with_openssl_rand_base64_32_value

# Optional local ports and log level.
CAUSALITY_WEB_PORT=8080
CAUSALITY_MCP_PORT=8081
CAUSALITY_LOG_LEVEL=info
