{
  "name": "@causality/semantic-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "smoke:model": "pnpm --filter @causality/contracts build && pnpm --filter @causality/semantic-core build && tsx src/realModelSmoke.ts",
    "quality:model": "pnpm --filter @causality/contracts build && pnpm --filter @causality/semantic-core build && tsx src/qualityBenchmark.ts"
  },
  "dependencies": {
    "@causality/contracts": "workspace:*",
    "@causality/semantic-core": "workspace:*",
    "@huggingface/transformers": "4.2.0",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "pg": "8.22.0",
    "pgvector": "0.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.20.0",
    "pino-pretty": "13.1.3",
    "testcontainers": "12.0.4",
    "tsx": "4.23.1",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  }
}
