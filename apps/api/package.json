{
  "name": "@causality/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:migrate": "node dist/database/migrate.js",
    "start:seed": "node dist/database/test-data/fixedSeed.js",
    "start:verify": "node dist/database/verify.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts --name core_model",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/test-data/fixedSeed.ts",
    "db:simulate": "tsx src/database/test-data/simulate.ts",
    "db:verify": "tsx src/database/verify.ts",
    "graph:benchmark": "tsx src/database/benchmark/causalGraphBenchmark.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@causality/contracts": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/swagger": "9.8.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "13.1.3",
    "testcontainers": "12.0.4",
    "tsx": "4.23.1",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  }
}
