NODE_ENV=development
HOST=127.0.0.1
PORT=8081
CAUSALITY_API_URL=http://127.0.0.1:3000
CAUSALITY_API_TIMEOUT_MS=35000
CAUSALITY_INTERNAL_MCP_SECRET=efefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefef
# 仅 stdio 兼容模式需要；HTTP 模式使用每个请求携带的 Bearer Token。
# CAUSALITY_MCP_TOKEN=cau_pat_replace_with_a_personal_access_token
CAUSALITY_MCP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CAUSALITY_MCP_MAX_BODY_BYTES=8388608
# Only the controlled reverse proxy may supply x-causality-client-ip.
CAUSALITY_MCP_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
