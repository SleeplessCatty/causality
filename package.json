{
  "name": "causality",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "dev": "pnpm --filter @causality/contracts build && pnpm --parallel --filter @causality/api --filter @causality/web dev",
    "dev:web": "pnpm --filter @causality/contracts build && pnpm --filter @causality/web dev",
    "dev:api": "pnpm --filter @causality/contracts build && pnpm --filter @causality/api dev",
    "dev:semantic-worker": "pnpm --filter @causality/contracts build && pnpm --filter @causality/semantic-core build && pnpm --filter @causality/semantic-worker dev",
    "db:generate": "pnpm --filter @causality/api db:generate",
    "db:migrate": "pnpm --filter @causality/api db:migrate",
    "db:seed": "pnpm --filter @causality/api db:seed",
    "db:simulate": "pnpm --filter @causality/api db:simulate",
    "db:verify": "pnpm --filter @causality/api db:verify",
    "data-check:benchmark": "DOCKER_HOST=\"${DOCKER_HOST:-$(docker context inspect --format '{{.Endpoints.docker.Host}}')}\" TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=\"${TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE:-/var/run/docker.sock}\" pnpm --filter @causality/api data-check:benchmark",
    "graph:benchmark": "DOCKER_HOST=\"${DOCKER_HOST:-$(docker context inspect --format '{{.Endpoints.docker.Host}}')}\" TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=\"${TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE:-/var/run/docker.sock}\" pnpm --filter @causality/api graph:benchmark",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @causality/contracts typecheck && pnpm --filter @causality/api typecheck && pnpm --filter @causality/web typecheck",
    "test": "pnpm --filter @causality/contracts test && pnpm --filter @causality/api test && pnpm --filter @causality/web test",
    "test:compose": "node --test tests/production/*.test.mjs",
    "test:integration": "DOCKER_HOST=\"${DOCKER_HOST:-$(docker context inspect --format '{{.Endpoints.docker.Host}}')}\" TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=\"${TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE:-/var/run/docker.sock}\" pnpm --filter @causality/api test:integration",
    "test:production": "bash scripts/test-production-compose.sh",
    "test:e2e": "bash scripts/test-e2e.sh",
    "build": "pnpm --filter @causality/contracts build && pnpm --filter @causality/api build && pnpm --filter @causality/web build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "eslint": "10.7.0",
    "prettier": "3.9.5",
    "typescript": "6.0.2",
    "typescript-eslint": "8.64.0"
  }
}
